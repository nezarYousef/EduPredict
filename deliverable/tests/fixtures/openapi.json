  "components": {
    "schemas": {
      "AssessmentSubmission": {
        "properties": {
          "date_submitted": {
            "type": "integer",
            "title": "Date Submitted"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "assessment_type": {
            "type": "string",
            "title": "Assessment Type"
          },
          "date": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          }
        },
        "type": "object",
        "required": [
          "date_submitted",
          "score",
          "assessment_type"
        ],
        "title": "AssessmentSubmission"
      },
      "BatchItem": {
        "properties": {
          "student_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Student Id"
          },
          "request": {
            "$ref": "#/components/schemas/PredictRequest"
          }
        },
        "type": "object",
        "required": [
          "student_id",
          "request"
        ],
        "title": "BatchItem"
      },
      "BatchRequest": {
        "properties": {
          "students": {
            "items": {
              "$ref": "#/components/schemas/BatchItem"
            },
            "type": "array",
            "title": "Students"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold"
          }
        },
        "type": "object",
        "required": [
          "students"
        ],
        "title": "BatchRequest"
      },
      "BatchResponse": {
        "properties": {
          "total_students": {
            "type": "integer",
            "title": "Total Students"
          },
          "high_risk_count": {
            "type": "integer",
            "title": "High Risk Count"
          },
          "medium_risk_count": {
            "type": "integer",
            "title": "Medium Risk Count"
          },
          "low_risk_count": {
            "type": "integer",
            "title": "Low Risk Count"
          },
          "threshold_used": {
            "type": "number",
            "title": "Threshold Used"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/BatchStudentResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "total_students",
          "high_risk_count",
          "medium_risk_count",
          "low_risk_count",
          "threshold_used",
          "results"
        ],
        "title": "BatchResponse"
      },
      "BatchStudentResult": {
        "properties": {
          "student_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Student Id"
          },
          "risk_probability": {
            "type": "number",
            "title": "Risk Probability"
          },
          "risk_level": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "at_risk": {
            "type": "integer",
            "title": "At Risk"
          },
          "explanation": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Explanation"
          },
          "completeness_pct": {
            "type": "number",
            "title": "Completeness Pct"
          }
        },
        "type": "object",
        "required": [
          "student_id",
          "risk_probability",
          "risk_level",
          "at_risk",
          "explanation",
          "completeness_pct"
        ],
        "title": "BatchStudentResult"
      },
      "DataCompleteness": {
        "properties": {
          "has_vle_data": {
            "type": "boolean",
            "title": "Has Vle Data"
          },
          "has_assessment_data": {
            "type": "boolean",
            "title": "Has Assessment Data"
          },
          "features_available": {
            "type": "integer",
            "title": "Features Available"
          },
          "features_total": {
            "type": "integer",
            "title": "Features Total"
          },
          "completeness_pct": {
            "type": "number",
            "title": "Completeness Pct"
          }
        },
        "type": "object",
        "required": [
          "has_vle_data",
          "has_assessment_data",
          "features_available",
          "features_total",
          "completeness_pct"
        ],
        "title": "DataCompleteness"
      },
      "Demographics": {
        "properties": {
          "code_module": {
            "type": "string",
            "title": "Code Module"
          },
          "gender_bin": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Gender Bin"
          },
          "disability_bin": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Disability Bin"
          },
          "age_numeric": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Age Numeric"
          },
          "edu_numeric": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Edu Numeric"
          },
          "imd_numeric": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Imd Numeric"
          },
          "num_of_prev_attempts": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Num Of Prev Attempts"
          },
          "studied_credits": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Studied Credits"
          },
          "module_total_assessments": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Module Total Assessments"
          },
          "course_length": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Course Length"
          }
        },
        "type": "object",
        "required": [
          "code_module",
          "gender_bin",
          "disability_bin",
          "age_numeric",
          "edu_numeric",
          "imd_numeric",
          "num_of_prev_attempts",
          "studied_credits",
          "module_total_assessments",
          "course_length"
        ],
        "title": "Demographics"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "model_loaded": {
            "type": "boolean",
            "title": "Model Loaded"
          },
          "feature_count": {
            "type": "integer",
            "title": "Feature Count"
          },
          "snapshots": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Snapshots"
          },
          "default_threshold": {
            "type": "number",
            "title": "Default Threshold"
          }
        },
        "type": "object",
        "required": [
          "status",
          "model_loaded",
          "feature_count",
          "snapshots",
          "default_threshold"
        ],
        "title": "HealthResponse"
      },
      "ModelConfidence": {
        "properties": {
          "day_of_course": {
            "type": "integer",
            "title": "Day Of Course"
          },
          "closest_snapshot": {
            "type": "integer",
            "title": "Closest Snapshot"
          },
          "expected_f1": {
            "type": "number",
            "title": "Expected F1"
          },
          "expected_auc": {
            "type": "number",
            "title": "Expected Auc"
          }
        },
        "type": "object",
        "required": [
          "day_of_course",
          "closest_snapshot",
          "expected_f1",
          "expected_auc"
        ],
        "title": "ModelConfidence"
      },
      "PredictRequest": {
        "properties": {
          "day_of_course": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Day Of Course"
          },
          "demographics": {
            "$ref": "#/components/schemas/Demographics"
          },
          "vle_log": {
            "items": {
              "$ref": "#/components/schemas/VLEEvent"
            },
            "type": "array",
            "title": "Vle Log",
            "default": []
          },
          "assess_log": {
            "items": {
              "$ref": "#/components/schemas/AssessmentSubmission"
            },
            "type": "array",
            "title": "Assess Log",
            "default": []
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold"
          }
        },
        "type": "object",
        "required": [
          "day_of_course",
          "demographics"
        ],
        "title": "PredictRequest"
      },
      "PredictResponse": {
        "properties": {
          "risk_probability": {
            "type": "number",
            "title": "Risk Probability"
          },
          "risk_level": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "at_risk": {
            "type": "integer",
            "title": "At Risk"
          },
          "recommended_action": {
            "type": "string",
            "title": "Recommended Action"
          },
          "explanation": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Explanation"
          },
          "threshold_used": {
            "type": "number",
            "title": "Threshold Used"
          },
          "model_confidence": {
            "$ref": "#/components/schemas/ModelConfidence"
          },
          "data_completeness": {
            "$ref": "#/components/schemas/DataCompleteness"
          }
        },
        "type": "object",
        "required": [
          "risk_probability",
          "risk_level",
          "at_risk",
          "recommended_action",
          "explanation",
          "threshold_used",
          "model_confidence",
